<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Height="190" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>
        <!-- Spring Easing Function untuk transisi fisik elastis -->
        <BackEase x:Key="SpringEaseOut" EasingMode="EaseOut" Amplitude="0.18"/>
        <CubicEase x:Key="SmoothEaseOut" EasingMode="EaseOut"/>

        <!-- Tombol Kontrol Media Minimalis -->
        <Style x:Key="MediaControlBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="14" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol Panah Swipe Navigasi (Sangat Minimalis, Clean, Tanpa Background) -->
        <Style x:Key="SwipeNavBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Canvas Wrapper (HWND tetap statis di tepi atas layar) -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
        
        <!-- Wadah Dynamic Island (Gradasi Album Halus, Menempel Bezel Atas) -->
        <Border x:Name="IslandBorder"
                Width="125"
                Height="28"
                CornerRadius="0,0,14,14"
                BorderBrush="#18FFFFFF"
                BorderThickness="0,0,0,1"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

            <!-- Latar Belakang Gradasi Halus: Hitam di Bezel Atas memudar ke Aksen Album di Bawah -->
            <Border.Background>
                <LinearGradientBrush x:Name="IslandBgBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#000000" Offset="0.0"/>
                    <GradientStop Color="#080C14" Offset="0.45"/>
                    <GradientStop x:Name="AlbumGradientStop" Color="#000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Soft Black Drop Shadow Murni -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="0.55" ShadowDepth="2" Direction="270"/>
            </Border.Effect>

            <!-- Menu Klik Kanan Notch -->
            <Border.ContextMenu>
                <ContextMenu Background="#181818" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <MenuItem Header="Settings" Click="SettingsMenuItem_Click" FontWeight="SemiBold"/>
                    <Separator Background="#33FFFFFF"/>
                    <MenuItem Header="Exit" Click="ExitMenuItem_Click" FontWeight="SemiBold"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- ============================================================== -->
                <!-- 1. TAMPILAN UNHOVERED / COMPACT                                -->
                <!-- Musik: Logo Music | Judul Lagu | Spectrum Waves               -->
                <!-- Idle: Jam Digital (HH:mm) | Icon Charger jika plug-in          -->
                <!-- ============================================================== -->
                <Grid x:Name="CompactView" Opacity="1" Margin="9,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Kiri: Logo Musik (♪) atau Indikator Charger Ring -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon Charger Ring -->
                        <Grid x:Name="CompactChargerIcon" Width="16" Height="16" Visibility="Collapsed">
                            <Ellipse Width="15" Height="15" Stroke="#1B3822" StrokeThickness="2"/>
                            <Path Data="M 7.5,1 A 6.5,6.5 0 1,1 1.5,9.5"
                                  Stroke="#30D158" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 8.5,3.5 L 5.5,8 L 8,8 L 6.5,12.5 L 10.5,7.5 L 8.5,7.5 Z"
                                  Fill="#30D158" Stretch="Uniform" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Logo Musik Cantik (Pengganti Album Cover saat Memutar Lagu) -->
                        <Grid x:Name="CompactMusicIcon" Width="15" Height="15" Visibility="Collapsed" VerticalAlignment="Center">
                            <Path Data="M 10,2 L 5,4.8 V 11.2 A 2,2 0 1,0 7,13 V 6.2 L 10,4.5 V 9.8 A 2,2 0 1,0 12,11.6 V 2 Z"
                                  Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Tengah: Judul Lagu (saat ada musik) ATAU Jam Digital (saat idle) -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,5,0">
                        <!-- Judul Lagu Ellipsis -->
                        <TextBlock x:Name="CompactTitleText" Text="Song Title"
                                   Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="110"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- Jam Digital Elegan (HH:mm) -->
                        <TextBlock x:Name="CompactClockText" Text="21:00"
                                   Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <!-- Kanan: Audio Spectrum Wave Bars (||||) -->
                    <StackPanel Grid.Column="2" x:Name="CompactSpectrumPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border x:Name="SpecBar1" Width="2.2" Height="6" Background="#FFFFFF" CornerRadius="1" Margin="1,0"/>
                        <Border x:Name="SpecBar2" Width="2.2" Height="11" Background="#FFFFFF" CornerRadius="1" Margin="1,0"/>
                        <Border x:Name="SpecBar3" Width="2.2" Height="8" Background="#FFFFFF" CornerRadius="1" Margin="1,0"/>
                        <Border x:Name="SpecBar4" Width="2.2" Height="13" Background="#FFFFFF" CornerRadius="1" Margin="1,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================================== -->
                <!-- 2. TAMPILAN POP-UP CHARGING (SS 1)                             -->
                <!-- ============================================================== -->
                <Grid x:Name="ChargingPopupView" Opacity="0" Visibility="Collapsed" Margin="14,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Width="26" Height="26" Stroke="#1E3E28" StrokeThickness="3.2"/>
                        <Path Data="M 13,1.5 A 11.5,11.5 0 1,1 3,17"
                              Stroke="#30D158" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 11,2 L 4,11 L 9,11 L 7,18 L 15,9 L 10,9 Z"
                              Fill="White" Stretch="Uniform" Width="10" Height="10"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Charging" Foreground="White" FontSize="13.5" FontWeight="Bold"/>
                        <TextBlock Text="Charger connected" Foreground="#888888" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" x:Name="ChargingPercentText" Text="70%"
                               Foreground="White" FontSize="21" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="0,0,2,0"/>
                </Grid>

                <!-- ============================================================== -->
                <!-- 3. TAMPILAN POP-UP TWS EARBUDS CONNECTED (SS 2)                -->
                <!-- ============================================================== -->
                <Grid x:Name="TwsPopupView" Opacity="0" Visibility="Collapsed" Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Width="26" Height="26" Stroke="#12263A" StrokeThickness="3.2"/>
                        <Path Data="M 13,1.5 A 11.5,11.5 0 1,1 4,20"
                              Stroke="#00A2FF" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 5,2 L 5,14 M 5,2 L 9.5,5.5 L 5,8.5 L 9.5,11.5 L 5,14"
                              Stroke="White" StrokeThickness="1.4" StrokeLineJoin="Miter"
                              Stretch="Uniform" Width="9" Height="11"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TwsDeviceNameText" Text="AirBuds Pro"
                                   Foreground="White" FontSize="13.5" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TwsStatusText" Text="Connected · 70%"
                                   Foreground="#888888" FontSize="10" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="2" Width="32" Height="32" VerticalAlignment="Center">
                        <Ellipse Width="30" Height="30" Stroke="#2500A2FF" StrokeThickness="1.5"/>
                        <Ellipse Width="22" Height="22" Stroke="#4500A2FF" StrokeThickness="1.5"/>
                        <Path Data="M 4,11 A 8,8 0 0,1 20,11 L 20,16 A 2,2 0 0,1 18,18 L 17,18 A 2,2 0 0,1 15,16 L 15,12 A 2,2 0 0,1 17,10 L 19,10 A 7,7 0 0,0 5,10 L 7,10 A 2,2 0 0,1 9,12 L 9,16 A 2,2 0 0,1 7,18 L 6,18 A 2,2 0 0,1 4,16 Z"
                              Fill="White" Stretch="Uniform" Width="13" Height="13"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ============================================================== -->
                <!-- 4. TAMPILAN POP-UP NOTIFIKASI WINDOWS                          -->
                <!-- ============================================================== -->
                <Grid x:Name="NotificationPopupView" Opacity="0" Visibility="Collapsed" Margin="12,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="NotifBadgeBorder" Width="28" Height="28" CornerRadius="14"
                            Background="#25D366" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path x:Name="NotifBadgeIcon"
                              Data="M 4,4 L 16,4 A 2,2 0 0,1 18,6 L 18,14 A 2,2 0 0,1 16,16 L 8,16 L 4,20 L 4,6 A 2,2 0 0,1 4,4 Z"
                              Fill="White" Stretch="Uniform" Width="13" Height="13"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifTitleText" Text="Notification"
                                   Foreground="White" FontSize="12.5" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifBodyText" Text="Message body..."
                                   Foreground="#A5A5A5" FontSize="10.5" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================================== -->
                <!-- 5. TAMPILAN EXPANDED MULTI-PAGE DENGAN SWIPE (HOVER MODE)      -->
                <!-- ============================================================== -->
                <Grid x:Name="ExpandedContainerView" Opacity="0" Visibility="Collapsed">
                    
                    <!-- Halaman 1: SPOTIFY PLAYER DENGAN EXPANDABLE LYRICS PANE -->
                    <Grid x:Name="Page1Media" Visibility="Visible" Margin="22,10,22,10">
                        <Grid.ColumnDefinitions>
                            <!-- Kolom 0: Kotak Pemutar Musik Utama -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 1: Panel Lirik Bersebelahan (Muncul Saat Tombol Lirik Di-klik) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sisi Kiri: Pemutar Musik (Artwork, Scrubber & Kontrol) -->
                        <Grid Grid.Column="0" Width="292">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Baris 1: Cover Album & Info Lagu -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cover Album Kotak Rounded Elegan -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                                        Background="#181818" ClipToBounds="True" Margin="0,0,10,0"
                                        BorderBrush="#25FFFFFF" BorderThickness="1">
                                    <Image x:Name="FullAlbumArt" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info Judul & Artis -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="FullTitleText" Text="Song Title"
                                               Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FullArtistText" Text="Artist Name"
                                               Foreground="#8E9297" FontSize="10.5" FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0"/>
                                    <TextBlock x:Name="SourceAppText" Text="Spotify"
                                               Foreground="#1ED760" FontSize="9" FontWeight="SemiBold"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Baris 2: Scrubber Timeline Progress Lagu -->
                            <Grid Grid.Row="1" Margin="0,7,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" x:Name="TrackPositionText" Text="00:00"
                                           Foreground="#78808A" FontSize="9" VerticalAlignment="Center"/>

                                <Grid Grid.Column="1" x:Name="TrackProgressContainer" Height="3.5" Margin="8,0" VerticalAlignment="Center">
                                    <Border Background="#25FFFFFF" CornerRadius="1.75"/>
                                    <Border x:Name="TrackProgressFill" HorizontalAlignment="Left" Width="4"
                                            Background="#FFFFFF" CornerRadius="1.75"/>
                                </Grid>

                                <TextBlock Grid.Column="2" x:Name="TrackDurationText" Text="-00:00"
                                           Foreground="#78808A" FontSize="9" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Baris 3: Tombol Lirik (Kiri) & Tombol Kontrol Media (Kanan) -->
                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tombol Toggle Expand Lirik (Speech/Quote Bubble) -->
                                <Button Grid.Column="0" x:Name="LyricsToggleBtn" Style="{StaticResource MediaControlBtn}"
                                        Width="27" Height="27" Click="LyricsToggleBtn_Click" ToolTip="Buka Lirik Lagu">
                                    <!-- Ikon Speech Bubble dengan Garis Lirik (Mirip SS Referensi) -->
                                    <Path x:Name="LyricsToggleIcon"
                                          Data="M 3,3 C 1.9,3 1,3.9 1,5 V 12 C 1,13.1 1.9,14 3,14 H 5 V 17 L 8.5,14 H 15 C 16.1,14 17,13.1 17,12 V 5 C 17,3.9 16.1,3 15,3 H 3 Z M 4.5,6 H 13.5 V 7.2 H 4.5 Z M 4.5,8.8 H 10.5 V 10 H 4.5 Z"
                                          Fill="#90FFFFFF" Stretch="Uniform" Width="11" Height="11"/>
                                </Button>

                                <!-- Tombol Prev, Play/Pause, Next Track -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Prev Track (|◀) -->
                                    <Button Style="{StaticResource MediaControlBtn}" Width="26" Height="26" Click="PrevButton_Click" Margin="3,0" ToolTip="Previous Track">
                                        <Path Data="M 3,4 H 5.5 V 16 H 3 Z M 15,4 L 6.5,10 L 15,16 Z" Fill="White" Stretch="Uniform" Width="9" Height="9"/>
                                    </Button>

                                    <!-- Play / Pause (▶ / ⏸) -->
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource MediaControlBtn}" Width="29" Height="29"
                                            Background="#28FFFFFF" Click="PlayPauseButton_Click" Margin="3,0" ToolTip="Play / Pause">
                                        <Path x:Name="PlayPauseIcon" Data="M 5,3 L 16,10 L 5,17 Z" Fill="White" Stretch="Uniform" Width="9.5" Height="9.5"/>
                                    </Button>

                                    <!-- Next Track (▶|) -->
                                    <Button Style="{StaticResource MediaControlBtn}" Width="26" Height="26" Click="NextButton_Click" Margin="3,0" ToolTip="Next Track">
                                        <Path Data="M 4,4 L 12.5,10 L 4,16 Z M 13.5,4 H 16 V 16 H 13.5 Z" Fill="White" Stretch="Uniform" Width="9" Height="9"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Sisi Kanan: Panel Lirik Bersebelahan (Expanded Lyrics Pane) -->
                        <Grid Grid.Column="1" x:Name="LyricsExpandedPane" Visibility="Collapsed" Width="210">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Garis Pemisah Vertikal Halus -->
                            <Border Grid.Column="0" Width="1" Background="#20FFFFFF" VerticalAlignment="Stretch" Margin="10,2,12,2"/>

                            <!-- Deretan Baris Lirik (Atas, Aktif Tebal, Bawah) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LyricLineAbove" Text=""
                                           Foreground="#55FFFFFF" FontSize="10" FontWeight="Normal"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                <TextBlock x:Name="LyricLineCurrent" Text="♪ Menghubungkan lirik..."
                                           Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                <TextBlock x:Name="LyricLineBelow" Text=""
                                           Foreground="#55FFFFFF" FontSize="10" FontWeight="Normal"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <TextBlock x:Name="LyricLineBelow2" Text=""
                                           Foreground="#30FFFFFF" FontSize="9" FontWeight="Normal"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Halaman 2: STATUS BATERAI (RAPIH & COMPACT TANPA GAP BESAR) -->
                    <Grid x:Name="Page2Battery" Visibility="Collapsed" VerticalAlignment="Center" Margin="24,8,24,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Baris Atas: Icon Baterai, Status (Charging/Uncharged) & Persentase -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Circular Battery Ring -->
                            <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse x:Name="BatteryGaugeTrack" Width="32" Height="32" Stroke="#25FFFFFF" StrokeThickness="3"/>
                                <Path x:Name="BatteryGaugeArc" Data="M 17,2 A 15,15 0 1,1 5,23"
                                      Stroke="#30D158" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <!-- Ikon Petir (Charging) / Ikon Baterai (Uncharged) -->
                                <Path x:Name="BatteryCenterIcon" Data="M 11,2 L 4,11 L 9,11 L 7,18 L 15,9 L 10,9 Z"
                                      Fill="#30D158" Stretch="Uniform" Width="10" Height="10"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Status Utama: Charging / Uncharged -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="BatteryStatusTitle" Text="Charging"
                                           Foreground="#30D158" FontSize="13.5" FontWeight="Bold"/>
                                <TextBlock x:Name="BatteryStatusSubtitle" Text="Power adapter connected"
                                           Foreground="#888888" FontSize="10" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Persentase Angka Besar -->
                            <TextBlock Grid.Column="2" x:Name="BatteryLargePercentText" Text="53%"
                                       Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Baris Bawah: Bar Progress Level Baterai & Rincian (Jarak Rapat & Proporsional) -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Border x:Name="BatteryBarContainer" Background="#1CFFFFFF" Height="4.5" CornerRadius="2.25" ClipToBounds="True">
                                <Border x:Name="BatteryHorizontalBar" HorizontalAlignment="Left" Width="140"
                                        Background="#30D158" CornerRadius="2.25"/>
                            </Border>
                            <Grid Margin="0,4,0,0">
                                <TextBlock x:Name="BatteryDetailLeft" Text="Source: AC Power" Foreground="#66FFFFFF" FontSize="9"/>
                                <TextBlock x:Name="BatteryDetailRight" Text="Health: Normal" HorizontalAlignment="Right" Foreground="#66FFFFFF" FontSize="9"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Halaman 3: AI QUICK PROMPT (MUNCUL SAAT ADA APLIKASI AI TERBUKA) -->
                    <Grid x:Name="Page3AiPrompt" Visibility="Collapsed" VerticalAlignment="Center" Margin="24,10,24,14">
                        <!-- Panel Saat Aplikasi AI Terdeteksi Terbuka (Gemini / ChatGPT / Codex / Claude / Claude Code) -->
                        <Grid x:Name="AiActivePanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Badge AI, Nama Aplikasi AI & Tombol Ganti AI (bila >1 aplikasi terbuka) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="AiBrandBadge" Width="28" Height="28" CornerRadius="9"
                                        Background="#254E82EE" BorderBrush="#554E82EE" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,9,0">
                                    <!-- Sparkle AI Icon (✦) -->
                                    <Path x:Name="AiBrandIcon"
                                          Data="M 10,1 L 12.2,7.8 L 19,10 L 12.2,12.2 L 10,19 L 7.8,12.2 L 1,10 L 7.8,7.8 Z"
                                          Fill="#4E82EE" Stretch="Uniform" Width="13" Height="13"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AiAppNameText" Text="Gemini"
                                               Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AiAppStatusText" Text="Active • Ketik prompt &amp; tekan Enter"
                                               Foreground="#888888" FontSize="9.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="2" x:Name="AiSwitchAppBtn" Style="{StaticResource MediaControlBtn}"
                                        Height="22" Padding="7,0" Click="AiSwitchAppBtn_Click"
                                        Visibility="Collapsed" ToolTip="Ganti Aplikasi AI Target">
                                    <TextBlock x:Name="AiSwitchAppText" Text="1/2 ⟳" Foreground="#D0FFFFFF" FontSize="9" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <!-- Kolom Chat Input Prompt + Tombol Send (➤) -->
                            <Border Grid.Row="1" x:Name="AiInputBorder"
                                    Background="#16FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                    CornerRadius="14" Height="32" Padding="11,0,4,0"
                                    MouseLeftButtonDown="AiInputBorder_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="AiPromptPlaceholder"
                                               Text="Tulis prompt untuk AI..."
                                               Foreground="#60FFFFFF" FontSize="11"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>

                                    <TextBox Grid.Column="0" x:Name="AiPromptTextBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                             FontSize="11" VerticalContentAlignment="Center"
                                             VerticalAlignment="Center"
                                             GotFocus="AiPromptTextBox_GotFocus"
                                             TextChanged="AiPromptTextBox_TextChanged"
                                             PreviewKeyDown="AiPromptTextBox_PreviewKeyDown"/>

                                    <Button Grid.Column="1" x:Name="AiSendPromptBtn" Style="{StaticResource MediaControlBtn}"
                                            Width="24" Height="24" Background="#4E82EE"
                                            Click="AiSendPromptBtn_Click" ToolTip="Kirim Prompt (Enter)">
                                        <Path Data="M 3,2 L 17,10 L 3,18 L 6,10 Z" Fill="#FFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="1,0,0,0"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Panel Kosong Saat TIDAK Ada Aplikasi AI yang Terbuka -->
                        <Grid x:Name="AiEmptyPanel" Visibility="Collapsed" Height="52">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.45">
                                <Path Data="M 10,1 L 12.2,7.8 L 19,10 L 12.2,12.2 L 10,19 L 7.8,12.2 L 1,10 L 7.8,7.8 Z"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13"
                                      HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="Tidak ada aplikasi AI yang terbuka"
                                           Foreground="#FFFFFF" FontSize="10.5" FontWeight="Medium"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Tombol Panah Swipe Navigasi KIRI (<) Minimalis & Clean -->
                    <Button x:Name="NavLeftBtn" Style="{StaticResource SwipeNavBtn}"
                            Width="15" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="3,0,0,0" Click="NavLeftBtn_Click" ToolTip="Halaman Sebelumnya">
                        <Path Data="M 6,1 L 1.5,5.5 L 6,10" Stroke="White" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="5.5" Height="9"/>
                    </Button>

                    <!-- Tombol Panah Swipe Navigasi KANAN (>) Minimalis & Clean -->
                    <Button x:Name="NavRightBtn" Style="{StaticResource SwipeNavBtn}"
                            Width="15" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0" Click="NavRightBtn_Click" ToolTip="Halaman Selanjutnya">
                        <Path Data="M 1.5,1 L 6,5.5 L 1.5,10" Stroke="White" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="5.5" Height="9"/>
                    </Button>

                    <!-- Indikator Titik Halaman (● ○ ○) di Bawah Tengah -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3">
                        <Ellipse x:Name="PageDot1" Width="4.5" Height="4.5" Fill="#FFFFFF" Margin="2,0"/>
                        <Ellipse x:Name="PageDot2" Width="4.5" Height="4.5" Fill="#35FFFFFF" Margin="2,0"/>
                        <Ellipse x:Name="PageDot3" Width="4.5" Height="4.5" Fill="#35FFFFFF" Margin="2,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>